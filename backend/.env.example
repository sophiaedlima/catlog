# Copie para .env e ajuste. O arquivo .env nunca vai para o Git.

# "dev" sobe um PostgreSQL embutido e dados de teste, sem instalar nada.
# Os dados do modo dev recomeçam a cada inicialização da API.
# Apague a linha abaixo para usar o PostgreSQL configurado em DB_URL.
spring.profiles.active=dev

# Segredo usado para assinar os tokens, com pelo menos 32 caracteres
JWT_SEGREDO=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Senha das contas de teste criadas no modo dev
CATLOG_SENHA_TESTE=catlog2026

# PostgreSQL real (ignorado no modo dev)
DB_URL=jdbc:postgresql://localhost:5432/catlog
DB_USUARIO=postgres
DB_SENHA=

# Cloudinary para as fotos. Vazio: as fotos ficam na pasta local "uploads"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mail de contato enviado ao Nominatim, conforme a política de uso do serviço
NOMINATIM_CONTATO=
